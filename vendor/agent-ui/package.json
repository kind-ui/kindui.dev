{
  "name": "@kind-ui/agent-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-operable AI components built on UI SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kind-ui/agent-ui.git",
    "directory": "packages/agent-ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/adapters/ai-sdk/index.d.ts",
      "default": "./dist/adapters/ai-sdk/index.js"
    },
    "./styles.css": "./dist/styles/agent-ui.css"
  },
  "scripts": {
    "build": "tsc -b && node --eval \"fs.rmSync('dist/styles', { recursive: true, force: true }); fs.cpSync('src/styles', 'dist/styles', { recursive: true })\"",
    "prepack": "npm run build && node --eval \"fs.copyFileSync('../../THIRD_PARTY_NOTICES.md', 'THIRD_PARTY_NOTICES.md')\"",
    "lint": "node ../../scripts/check-ui-sdk-usage.mjs",
    "test:unit": "node --test \"tests/core/*.test.mjs\""
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "marked": "18.2.0",
    "mdast-util-definitions": "6.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-sanitize-uri": "2.0.1",
    "motion": "14.14.0",
    "remend": "1.4.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@ui-sdk/react": "0.1.0-beta.1",
    "@ui-sdk/web": "0.1.0-beta.1",
    "ai": "7.0.173"
  }
}
