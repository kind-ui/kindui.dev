{
  "agent-ui": {
    "repo": "kind-ui/agent-ui",
    "title": "Agent UI",
    "tag": "v{version}",
    "version": "0.6.0",
    "package": "@kind-ui/agent-ui",
    "docs": "apps/docs",
    "paths": [
      "apps/docs/content",
      "apps/docs/examples",
      "apps/docs/source.config.ts",
