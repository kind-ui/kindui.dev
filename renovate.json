{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Library releases pinned in libraries.json",
      "managerFilePatterns": ["/^libraries\\.json$/"],
      "matchStrings": ["\"repo\": \"(?<depName>[^\"]+)\",[^}]*?\"version\": \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "A library's release, its npm package and its UI SDK pins move together",
      "groupName": "agent-ui",
      "matchPackageNames": ["kind-ui/agent-ui", "@kind-ui/agent-ui", "@ui-sdk/**"]
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kind-ui/agent-ui"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Charts' release and its npm package move together",
      "groupName": "charts",
      "matchPackageNames": ["kind-ui/charts", "@kind-ui/charts"]
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kind-ui/charts"],
      "extractVersion": "^@kind-ui/charts@(?<version>.+)$"
    }
  ]
}
